<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" 
    xmlns:doap="http://usefulinc.com/ns/doap#"
    xmlns:juliapi="https://juwulia.dev/juliapi#">
<doap:Project>
    <doap:name>Saw</doap:name>

    <juliapi:port>
        <juliapi:AudioOutput>
            <juliapi:name>Output</juliapi:name>
            <juliapi:bufferType>f32</juliapi:bufferType>
        </juliapi:AudioOutput>
    </juliapi:port>
    <juliapi:port>
        <juliapi:ParamInput>
            <juliapi:name>Gain</juliapi:name>
            <juliapi:bufferType>
                <juliapi:Float/>
            </juliapi:bufferType>
            <juliapi:min>0.0</juliapi:min>
            <juliapi:max>1.0</juliapi:max>
        </juliapi:ParamInput>
    </juliapi:port>
</doap:Project>
</rdf:RDF>